{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Asia/Tokyo",
  "schedule": [
    "* 5-8 * * 6"
  ],
  "vulnerabilityAlerts": {
    "schedule": [
      "at any time"
    ]
  },
  "git-submodules": {
    "enabled": true
  },
  "gitIgnoredAuthors": [
    "41898282+github-actions[bot]@users.noreply.github.com"
  ],
  "packageRules": [
    {
      "description": "kustomize follows the version bundled in Argo CD: the kustomize-version workflow sets it on the argo-cd chart's PRs",
      "matchManagers": ["mise"],
      "matchDepNames": ["kustomize"],
      "enabled": false
    },
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "minor and patch updates"
    }
  ]
}
